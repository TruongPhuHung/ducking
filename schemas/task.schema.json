{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ducking/schemas/task-v1.json",
  "title": "Ducking Task v1",
  "type": "object",
  "required": [
    "contract_version",
    "task_id",
    "base_sha",
    "objective",
    "acceptance",
    "context_files",
    "allowed_paths",
    "forbidden_paths",
    "validation_profiles",
    "budget"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "objective": {"type": "string", "minLength": 1},
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "proof"],
        "properties": {
          "id": {"type": "string"},
          "claim": {"type": "string", "minLength": 1},
          "proof": {"enum": ["test", "diff", "manual"]}
        },
        "additionalProperties": true
      }
    },
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "context_files": {"type": "array", "items": {"type": "string"}},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "validation_profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}
    },
    "flock_attempt": {
      "type": "object",
      "required": [
        "flock_id",
        "lease_id",
        "coordinator_epoch",
        "slot_id",
        "duck_incarnation",
        "contract_sha256",
        "branch_ref"
      ],
      "properties": {
        "flock_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "lease_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "coordinator_epoch": {"type": "integer", "minimum": 1},
        "slot_id": {"type": "integer", "minimum": 0, "maximum": 5},
        "duck_incarnation": {"type": "integer", "minimum": 1},
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "branch_ref": {"type": "string", "pattern": "^ducking/[^\\s]+$"}
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["wall_seconds", "max_fix_rounds"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 1},
        "max_fix_rounds": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

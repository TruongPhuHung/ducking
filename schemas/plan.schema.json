{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ducking/schemas/plan-v2.json",
  "title": "Ducking Flock Plan v2",
  "type": "object",
  "required": ["contract_version", "plan_id", "base_sha", "goal", "units"],
  "properties": {
    "contract_version": {"const": 2},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "goal": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "retry": {
      "type": "object",
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10, "default": 3},
        "delays_seconds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0},
          "default": [5, 30]
        }
      },
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "properties": {
        "liveness_soft_seconds": {"type": "integer", "minimum": 1, "default": 45},
        "liveness_hard_seconds": {"type": "integer", "minimum": 1, "default": 90},
        "progress_soft_seconds": {"type": "integer", "minimum": 1, "default": 120},
        "progress_hard_seconds": {"type": "integer", "minimum": 1, "default": 600}
      },
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "task.schema.json"}
    }
  },
  "additionalProperties": false
}
